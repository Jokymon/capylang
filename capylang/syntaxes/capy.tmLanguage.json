{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "CapyLang",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#includes"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#types"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "punctuation.definition.comment.capy"
						}
					},
					"match": "(//).*$",
					"name": "comment.line.double-slash.capy"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "punctuation.separator.dot.decimal.capy"
						},
						"2": {
							"name": "keyword.operator.exponent.capy"
						},
						"3": {
							"name": "keyword.operator.exponent.sign.capy"
						},
						"4": {
							"name": "constant.numeric.decimal.exponent.mantissa.capy"
						},
						"5": {
							"name": "entity.name.type.numeric.capy"
						}
					},
					"match": "\\b\\d[_\\d]*(\\.?)[_\\d]*(?:([Ee])([-+]?)([_\\d]+))?(f32|f64|s8|s16|s32|s64|s128|u8|u16|u32|u64|u128)?\\b",
					"name": "constant.numeric.decimal.capy"
				},
				{
					"comment": "hexadecimal integers",
					"name": "constant.numeric.hex.capy",
					"match": "\\b0x[\\da-fA-F_]+(s8|s16|s32|s64|s128|u8|u16|u32|u64|u128)?\\b",
					"captures": {
						"1": {
							"name": "entity.name.type.numeric.capy"
						}
					}
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.other.capy",
					"match": "\\b(allocate|global|import|include|as)\\b"
				},
				{
					"name": "keyword.control.capy",
					"match": "\\b(break|else|if|return|while)\\b"
				},
				{
					"name": "keyword.other.fn.capy",
					"match": "\\b(fn)\\b"
				},
				{
					"name": "keyword.other.capy storage.type.capy",
					"match": "\\b(let)\\b"
				},
				{
					"name": "storage.modifier.capy",
					"match": "\\b(mut)\\b"
				},
				{
					"name": "keyword.declaration.struct.capy storage.type.capy",
					"match": "\\b(record)\\b"
				}
			]
		},
		"includes": {
			"patterns": [
				{
					"name": "meta.include.capy",
					"match": "\\b(include)\\s+(\")((?:\\\\.|[^\"\\\\])*)(\")",
					"captures": {
						"1": {
							"name": "keyword.control.import.include.capy"
						},
						"2": {
							"name": "punctuation.definition.string.begin.capy"
						},
						"3": {
							"name": "entity.name.filename.capy markup.underline.link.capy"
						},
						"4": {
							"name": "punctuation.definition.string.end.capy"
						}
					}
				}
			]
		},
		"types": {
			"patterns": [
				{
					"captures": {
						"1": {
							"name": "keyword.declaration.struct.capy storage.type.capy"
						},
						"2": {
							"name": "entity.name.type.struct.capy"
						}
					},
					"match": "\\b(record)\\s+([a-zA-Z0-9_]+)\\b"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"match": "\\b([_$a-zA-Z][_$a-zA-Z0-9]*)\\b",
					"name": "variable.other.capy"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.blob.capy",
					"begin": "(b)\"",
					"beginCaptures": {
						"1": {
							"name": "storage.type.blob.capy"
						}
					},
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.capy",
							"match": "\\\\(?:[nt\\\\\"]|x[0-9a-f]{2})"
						},
						{
							"name": "invalid.illegal.non-ascii.blob.capy",
							"match": "[^\\x00-\\x7F]+"
						},
						{
							"name": "invalid.illegal.escape.capy",
							"match": "\\\\."
						}
					]
				},
				{
					"name": "string.quoted.double.utf8.capy",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.capy",
							"match": "\\\\(?:[nt\\\\\"]|u\\{[0-9A-Fa-f]+\\})"
						},
						{
							"name": "invalid.illegal.escape.capy",
							"match": "\\\\."
						}
					]
				}
			]
		}
	},
	"scopeName": "source.capy"
}
