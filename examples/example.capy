// This source file is used a kind of show case for various features of the capylang language. It doesn't have any
// particular purpose and does not try to solve anything.
include "/lib/wasi.capy"

fn print_s(s: string)
{
    let mut res: *u32 = cabi_realloc(0, 0, 4, 4) as *u32;

    let v: *iovec = allocate iovec{
        buf = s.ptr as *u32,
        len = s.size as u32,
    };

    fd_write(1u32, v as *u32, 1u32, res);   
}

fn print(value: u32)
{
    // allocate memory for the number output
    let s: *u8 = cabi_realloc(0, 0, 4, 12) as *u8;

    let mut remainder: u32 = value;

    let mut i: *u8 = s + (11u32 as *u8);
    while (remainder!=0)
    {
        let ch: char = '0' + (remainder % 10u32) as char;
        *i = ch;
        remainder = remainder / 10u32;

        i = i-(1 as *u8);
    }

    let v: *iovec = allocate iovec{
        buf = s as *u32,
        len = 12u32,
    };
    let mut res: *u32 = 96 as *u32;
    fd_write(1u32, v as *u32, 1u32, res);
}

@export
fn _start() {
    let mut res: *u32 = cabi_realloc(0, 0, 4, 4) as *u32;

    let s: string = "Hello \\strings 😀\u{932}\u{4dc} b\n";
    print_s(s);

    print(1234u32);
    print_s("\n");

    // let count: *u32 = 0 as *u32;
    // let size: *u32 = 0 as *u32;
    // res = args_sizes_get(count, size);
    // proc_exit(*count)
    proc_exit(2u32)
}