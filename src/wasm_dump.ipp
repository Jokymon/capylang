        if (value.init_expression.empty())
        {
            out << " []\n";
        }
        else
        {
            out.put('\n');
            for (const auto& item : value.init_expression)
            {
                dump_detail::write_indent(out, indent + 4);
                out.put('-');
                if (!item)
                {
                    out << " null\n";
                }
                else
                {
                    out.put('\n');
                    dump(out, ctx, *item, indent + 8);
                }
            }
        }
    }

